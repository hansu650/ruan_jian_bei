# General
APP_NAME=EduForge
APP_DISPLAY_NAME=EduForge 智学工坊
APP_ENV=development
COMPETITION_NAME=第十五届中国软件杯
COMPETITION_TRACK=A3
COMPETITION_TOPIC=基于大模型的个性化资源生成与学习多智能体系统开发

# Backend
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./eduforge.db

# LLM
USE_MOCK_LLM=true
LLM_PROVIDER=mock
LLM_MODEL=mock-edu-model
LLM_TIMEOUT_SECONDS=60

# Spark placeholder, reserved for future iFlytek integration
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_MODEL=

# Embedding
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
CHROMA_PERSIST_DIR=./.chroma

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
